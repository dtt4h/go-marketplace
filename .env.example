# Server
APP_ENV=development
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
CORS_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=marketplace
DB_SSLMODE=disable

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Redis (планируется)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Payments (планируется)
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=

# S3 / MinIO storage for images
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# SMTP for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Go Marketplace
SMTP_ENCRYPTION=starttls

# Telegram admin bot
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ADMIN_IDS=