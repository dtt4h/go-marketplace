# Server
APP_ENV=development
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
CORS_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# В production обязательно сменить!
DB_PASSWORD=postgres
DB_NAME=marketplace
DB_SSLMODE=disable

# JWT
# В production обязателен (длина >= 32 символа, не дефолтный)
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Redis (rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# В production обязательно сменить! Должен совпадать с docker-compose
REDIS_PASSWORD=redis

# Payments (планируется)
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
PAYMENTS_WEBHOOK_SECRET=

# S3 / MinIO storage for images
# В production: реальный S3 (https), в dev: MinIO (http://localhost:9000)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Должен совпадать с docker-compose
S3_BUCKET=marketplace

# SMTP for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Go Marketplace
SMTP_ENCRYPTION=starttls

# Telegram admin bot
# Token from @BotFather
TELEGRAM_BOT_TOKEN=8732544049:AAFoCmK1itjGhYqVdGvyhWijmWCDPSIUX9U
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ADMIN_IDS=7991080756